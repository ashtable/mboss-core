{
  "$schema": "https://mboss.dev/schemas/workflow-v1.json",
  "version": 1,
  "revision": 1,
  "name": "form_retry",
  "title": "Intake, asked again",
  "nodes": [
    { "id": "intake_requested", "kind": "trigger", "title": "Intake requested",
      "config": { "mode": "event", "topic": "intake.requested",
        "requesterEmailPath": "contact.email" },
      "out": "IntakeRequest" },
    { "id": "ask_details", "kind": "emailSend", "title": "Ask for the details",
      "in": "IntakeRequest",
      "config": { "to": "requestingUser", "subject": "A few details, please",
        "bodyMarkdown": "We need a little more before we can start.",
        "attach": { "type": "form", "form": { "fields": [
          { "id": "name", "label": "Your name", "type": "text", "required": true },
          { "id": "details", "label": "What happened?", "type": "textarea" } ] } } } },
    { "id": "await_details", "kind": "durableWait", "title": "Wait for the details",
      "config": { "source": { "kind": "form", "email": "ask_details" },
        "timeoutDays": 1, "onTimeout": "resend", "maxResends": 2, "afterMax": "abort" },
      "out": "IntakeAnswers" },
    { "id": "details_ok", "kind": "branch", "title": "Enough to go on?", "in": "IntakeAnswers",
      "config": { "cases": [
        { "port": "more", "when": { "path": "complete", "op": "eq", "value": false },
          "maxIterations": 3, "onExhausted": "abort" } ],
        "elsePort": "done" } },
    { "id": "record_intake", "kind": "step", "title": "Record the intake",
      "handler": { "export": "recordIntake" }, "in": "IntakeAnswers", "out": "IntakeRecord",
      "config": {} }
  ],
  "edges": [
    { "id": "e1", "from": { "node": "intake_requested", "port": "out" }, "to": { "node": "ask_details" }, "type": "IntakeRequest" },
    { "id": "e2", "from": { "node": "ask_details", "port": "out" }, "to": { "node": "await_details" } },
    { "id": "e3", "from": { "node": "await_details", "port": "out" }, "to": { "node": "details_ok" }, "type": "IntakeAnswers" },
    { "id": "e4", "from": { "node": "details_ok", "port": "more" }, "to": { "node": "ask_details" }, "back": true },
    { "id": "e5", "from": { "node": "details_ok", "port": "done" }, "to": { "node": "record_intake" }, "type": "IntakeAnswers" }
  ]
}
