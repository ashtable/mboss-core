{
  "$schema": "https://mboss.dev/schemas/workflow-v1.json",
  "version": 1,
  "revision": 1,
  "name": "form_intake",
  "title": "Intake form",
  "nodes": [
    { "id": "intake_requested", "kind": "trigger", "title": "Intake requested",
      "config": { "mode": "event", "topic": "intake.requested",
        "idempotencyKeyPath": "requestId", "requesterEmailPath": "contact.email" },
      "out": "IntakeRequest" },
    { "id": "ask_details", "kind": "emailSend", "title": "Ask for the details",
      "in": "IntakeRequest",
      "config": { "to": "requestingUser", "subject": "We'd like a few details",
        "bodyMarkdown": "Thanks for getting in touch. We can start work on this once you've told us a little more about it.",
        "attach": { "type": "form", "form": { "fields": [
          { "id": "name", "label": "Your name", "type": "text", "required": true },
          { "id": "urgent", "label": "Is this urgent?", "type": "yesNo" },
          { "id": "details", "label": "What's the rush?", "type": "textarea",
            "showIf": { "path": "urgent", "op": "eq", "value": true } },
          { "id": "photos", "label": "Anything to show us?", "type": "fileUpload",
            "multiple": true } ] } } } },
    { "id": "await_details", "kind": "durableWait", "title": "Wait for the details",
      "config": { "source": { "kind": "form", "email": "ask_details" },
        "timeoutDays": 3, "onTimeout": "abort" },
      "out": "IntakeAnswers" },
    { "id": "record_intake", "kind": "step", "title": "Record the intake",
      "handler": { "export": "recordIntake" }, "in": "IntakeAnswers", "out": "IntakeRecord",
      "config": {} }
  ],
  "edges": [
    { "id": "e1", "from": { "node": "intake_requested", "port": "out" }, "to": { "node": "ask_details" }, "type": "IntakeRequest" },
    { "id": "e2", "from": { "node": "ask_details", "port": "out" }, "to": { "node": "await_details" } },
    { "id": "e3", "from": { "node": "await_details", "port": "out" }, "to": { "node": "record_intake" }, "type": "IntakeAnswers" }
  ]
}
