{
  "$schema": "https://mboss.dev/schemas/workflow-v1.json",
  "version": 1,
  "revision": 1,
  "name": "checkout",
  "title": "Checkout",
  "nodes": [
    { "id": "order_placed", "kind": "trigger", "title": "Order placed",
      "config": { "mode": "event", "topic": "order.placed",
        "idempotencyKeyPath": "orderId",
        "requesterEmailPath": "customer.email" },
      "out": "OrderPlaced" },
    { "id": "reserve_stock", "kind": "transaction", "title": "Reserve stock",
      "handler": { "export": "reserveStock" },
      "in": "OrderPlaced", "out": "Reservation", "config": {} },
    { "id": "charge_card", "kind": "apiCall", "title": "Charge card",
      "handler": { "export": "chargeCard" },
      "in": "Reservation", "out": "Charge",
      "config": { "service": "payments" } },
    { "id": "charged", "kind": "branch", "title": "Did it go through?",
      "in": "Charge",
      "config": { "cases": [
        { "port": "yes",
          "when": { "path": "status", "op": "eq", "value": "captured" } } ],
        "elsePort": "no" } },
    { "id": "fulfill", "kind": "step", "title": "Fulfill order",
      "handler": { "export": "fulfillOrder" },
      "in": "Charge", "out": "Fulfilment", "config": {} },
    { "id": "confirm", "kind": "emailSend", "title": "Confirm order",
      "config": { "to": "requestingUser",
        "subject": "Your order is on its way",
        "bodyMarkdown": "We have taken payment and your order is being packed. You will hear from us again when it ships.",
        "attach": { "type": "none" } } },
    { "id": "release_stock", "kind": "transaction", "title": "Release stock",
      "handler": { "export": "releaseStock" },
      "in": "Charge", "out": "StockRelease", "config": {} },
    { "id": "decline", "kind": "emailSend", "title": "Report the decline",
      "config": { "to": "requestingUser",
        "subject": "We could not take payment",
        "bodyMarkdown": "Your card was declined, so nothing was charged and the items are back in stock. Try again whenever you like.",
        "attach": { "type": "none" } } }
  ],
  "edges": [
    { "id": "e1", "from": { "node": "order_placed", "port": "out" },
      "to": { "node": "reserve_stock" }, "type": "OrderPlaced" },
    { "id": "e2", "from": { "node": "reserve_stock", "port": "out" },
      "to": { "node": "charge_card" }, "type": "Reservation" },
    { "id": "e3", "from": { "node": "charge_card", "port": "out" },
      "to": { "node": "charged" }, "type": "Charge" },
    { "id": "e4", "from": { "node": "charged", "port": "yes" },
      "to": { "node": "fulfill" }, "type": "Charge" },
    { "id": "e5", "from": { "node": "fulfill", "port": "out" },
      "to": { "node": "confirm" }, "type": "Fulfilment" },
    { "id": "e6", "from": { "node": "charged", "port": "no" },
      "to": { "node": "release_stock" }, "type": "Charge" },
    { "id": "e7", "from": { "node": "release_stock", "port": "out" },
      "to": { "node": "decline" }, "type": "StockRelease" }
  ]
}
