{
  "$schema": "https://mboss.dev/schemas/workflow-v1.json",
  "version": 1,
  "revision": 1,
  "name": "deployment",
  "title": "Deployment",
  "nodes": [
    { "id": "release_requested", "kind": "trigger",
      "title": "Release requested",
      "config": { "mode": "event", "topic": "release.requested",
        "idempotencyKeyPath": "releaseId" },
      "out": "ReleaseRequest" },
    { "id": "build", "kind": "step", "title": "Build",
      "handler": { "export": "buildRelease" },
      "in": "ReleaseRequest", "out": "BuildArtifact", "config": {} },
    { "id": "approve_release", "kind": "approval", "title": "Approve release",
      "config": { "to": "releases@example.com",
        "subject": "Ship this release?",
        "message": "A build is waiting to go out. Open the link to ship it or hold it back.",
        "timeoutDays": 2 } },
    { "id": "deploy", "kind": "step", "title": "Deploy",
      "handler": { "export": "deployBuild" },
      "in": "BuildArtifact", "out": "Deployment", "config": {} },
    { "id": "settle", "kind": "durableWait", "title": "Let it settle",
      "config": { "source": { "kind": "timer", "seconds": 300 },
        "onTimeout": "abort" } },
    { "id": "check_health", "kind": "step", "title": "Check health",
      "handler": { "export": "checkHealth" },
      "in": "Deployment", "out": "HealthReport", "config": {} },
    { "id": "healthy", "kind": "branch", "title": "Is it healthy?",
      "in": "HealthReport",
      "config": { "cases": [
        { "port": "yes",
          "when": { "path": "healthy", "op": "eq", "value": true } } ],
        "elsePort": "no" } },
    { "id": "announce", "kind": "emailSend", "title": "Announce the release",
      "config": { "to": "releases@example.com",
        "subject": "The release is live",
        "bodyMarkdown": "The new version is deployed and reporting healthy.",
        "attach": { "type": "none" } } },
    { "id": "roll_back", "kind": "step", "title": "Roll back",
      "handler": { "export": "rollBack" },
      "in": "HealthReport", "out": "Rollback", "config": {} },
    { "id": "announce_rollback", "kind": "emailSend",
      "title": "Announce the rollback",
      "config": { "to": "releases@example.com",
        "subject": "The release was rolled back",
        "bodyMarkdown": "The new version came up unhealthy, so the previous one is serving again.",
        "attach": { "type": "none" } } }
  ],
  "edges": [
    { "id": "e1", "from": { "node": "release_requested", "port": "out" },
      "to": { "node": "build" }, "type": "ReleaseRequest" },
    { "id": "e2", "from": { "node": "build", "port": "out" },
      "to": { "node": "approve_release" }, "type": "BuildArtifact" },
    { "id": "e3", "from": { "node": "approve_release", "port": "approved" },
      "to": { "node": "deploy" }, "type": "BuildArtifact" },
    { "id": "e4", "from": { "node": "deploy", "port": "out" },
      "to": { "node": "settle" }, "type": "Deployment" },
    { "id": "e5", "from": { "node": "settle", "port": "out" },
      "to": { "node": "check_health" }, "type": "Deployment" },
    { "id": "e6", "from": { "node": "check_health", "port": "out" },
      "to": { "node": "healthy" }, "type": "HealthReport" },
    { "id": "e7", "from": { "node": "healthy", "port": "yes" },
      "to": { "node": "announce" } },
    { "id": "e8", "from": { "node": "healthy", "port": "no" },
      "to": { "node": "roll_back" }, "type": "HealthReport" },
    { "id": "e9", "from": { "node": "roll_back", "port": "out" },
      "to": { "node": "announce_rollback" }, "type": "Rollback" }
  ]
}
