// The application database for this project.
//
// One table, and it belongs to the runtime rather
// than to any workflow: which run is parked on
// which node, so an arriving event or a submitted
// form can find the run that is waiting for it.
// Everything a workflow itself remembers between
// blocks is kept by DBOS, in its own schema.
//
// Your own models go below this one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // No url here. Prisma 7 refuses one in this
  // block; the connection string is read from
  // prisma.config.ts instead.
  provider = "postgresql"
}

/// A run waiting on one node, and the topic and
/// key that will wake it. Keyed by run and node
/// rather than by topic and key, because two runs
/// of the same workflow wait on the same node all
/// the time and that is the ordinary case.
///
/// The park column is which occasion of waiting
/// the row is. A wait inside a loop parks on the
/// same node every round, and what wakes a run
/// carries an idempotency key that has to differ
/// between the rounds or the later ones are
/// dropped.
model WaitCorrelation {
  runId  String
  nodeId String
  topic  String
  key    String
  park   String

  @@id([runId, nodeId])
  @@index([topic, key])
  @@map("mboss_wait_correlations")
}
